NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_INSIGHTS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Contractor lead intake. Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Reuse the existing EmailJS account/service above. Enable non-browser requests.
# Keep private-key authorization enabled for server requests.
EMAILJS_PRIVATE_KEY=
# Leave owner override blank to reuse NEXT_PUBLIC_EMAILJS_TEMPLATE_ID.
EMAILJS_LEAD_OWNER_TEMPLATE_ID=
# Independent random secrets, each at least 32 characters.
LEAD_HASH_SECRET=
CRON_SECRET=

# Owner login uses the existing EmailJS notification inbox; default is myroslav@kredance.com.
# If overriding this, the Contact template's fixed recipient must be the same owner.
DASHBOARD_OWNER_EMAIL=
# Optional public Clarity project ID. Recordings load only after analytics consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
